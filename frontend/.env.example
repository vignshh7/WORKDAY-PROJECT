# Base URL of the Spring Boot backend.
# Leave blank to use Vite's dev proxy (vite.config.js forwards /api -> localhost:8080).
# Set to a full origin (e.g. https://api.example.com) for a deployed build.
VITE_API_BASE_URL=

# Only used by the dev server proxy when VITE_API_BASE_URL is blank.
VITE_PROXY_TARGET=http://localhost:8080
