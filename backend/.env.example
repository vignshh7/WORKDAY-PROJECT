# Copy to .env for local development. Never commit the real .env file.
# Phase 1: not required yet (DB autoconfiguration is disabled).
# Phase 2 onward: required to connect to Supabase PostgreSQL and run Flyway.

DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<supabase-db-password>

# Phase 5 onward: required for JWT signing. Must be at least 32 bytes (256 bits) — jjwt
# throws WeakKeyException at startup for HS256 if it's shorter.
JWT_SECRET=<a-long-random-base64-secret>
# JWT_EXPIRATION_MINUTES=1440

SERVER_PORT=8080

# Phase 20 onward: only required if CALENDAR_PROVIDER=google (defaults to "noop", which needs
# none of these). Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console,
# enable the Google Calendar API, and add GOOGLE_REDIRECT_URI (below) as an authorized redirect
# URI on that client - it must match exactly (scheme, host, port, path). This is a per-user
# connection (Phase 20 revision): every candidate/interviewer/recruiter connects their own
# calendar via GET /api/integrations/google-calendar/authorize, not one shared org account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google-calendar/callback
# CALENDAR_PROVIDER=google

# Base URL of the deployed frontend, no trailing slash - once set, Google's OAuth callback
# redirects the browser back into the frontend's own UI (see
# GoogleCalendarOAuthController's javadoc) instead of showing a bare backend page. Leave unset
# until a frontend exists.
# APP_BASE_URL=http://localhost:5173

# Phase 21: optional shared secret set as the watch channel's token when a Google Calendar
# webhook channel is created; verified on every push notification. Blank (default) skips
# verification - fine for local/demo use only.
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Phase 22 onward: only required if NOTIFICATION_EMAIL_PROVIDER=smtp (defaults to "noop", which
# just logs). EMAIL_API_KEY is a natural value for SPRING_MAIL_PASSWORD when using a
# transactional-email provider's SMTP relay (SendGrid/Mailgun/Postmark/etc) - or, for Gmail, an
# app password (myaccount.google.com/apppasswords) works the same way as SPRING_MAIL_PASSWORD.
# EMAIL_FROM=
# EMAIL_API_KEY=
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# NOTIFICATION_EMAIL_PROVIDER=smtp

# Phase 26 onward: only required for POST /api/ai/schedule (application.yml points the OpenAI
# client at OpenRouter, so this is an OpenRouter key from https://openrouter.ai/keys, not an
# OpenAI key). AI_MODEL can be any model id OpenRouter serves - see https://openrouter.ai/models
# (filter by "tools" support for function-calling models; ":free" ids have no cost).
# AI_API_KEY=
# AI_MODEL=nvidia/nemotron-3.5-lightning:free

# Added in later phases, not needed yet:
# CORS_ALLOWED_ORIGINS=
